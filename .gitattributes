# Windows 스크립트는 반드시 CRLF 로 체크아웃돼야 합니다.
# LF 로 받으면 .bat 의 명령이 깨지고 .vbs 는 아예 실행되지 않습니다.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# 나머지는 LF. .sh 는 CRLF 면 '/bin/sh^M: bad interpreter' 로 안 돕니다.
*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.txt text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.woff2 binary
